<apex:page controller="RE_DashboardController" sidebar="false" showHeader="true">
    
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f9fafb;
            margin: 0;
            padding: 0;
            color: #374151;
        }
    
        h1, h2, h3 {
            color: #111827;
        }
    
        .dashboard-container {
            padding: 20px;
        }
    
        .summary-grid {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
    
        .summary-tile {
            flex: 1;
            padding: 20px;
            border-radius: 8px;
            color: #fff;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            font-size: 16px;
        }
    
        .tile-blue { background: #3b82f6; }
        .tile-green { background: #22c55e; }
        .tile-orange { background: #f97316; }
        .tile-purple { background: #a855f7; }
    
        .card-section {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
    
        .list-card {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
            flex: 1 1 300px;
        }
    
        .sidebar {
            width: 220px;
            background: #1f2937;
            color: white;
            height: 100vh;
            padding: 20px;
            box-sizing: border-box;
            position: fixed;
            top: 0;
            left: 0;
        }
    
        .sidebar h3 {
            color: #fff;
            margin-bottom: 30px;
        }
    
        .sidebar a {
            display: block;
            color: white;
            padding: 12px 0;
            text-decoration: none;
            font-size: 14px;
        }
    
        .sidebar a:hover {
            background: #374151;
            border-radius: 4px;
            padding-left: 10px;
        }
    
        .main-content {
            margin-left: 220px;
            padding: 20px;
        }
    
        .lead-status {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 12px;
            color: white;
        }
    
        .status-qualified { background-color: #16a34a; }
        .status-new { background-color: #64748b; }
    
    </style>


    <div class="sidebar">
        <h3>RealEstate CRM</h3>
        <a href="/apex/RE_Home">Dashboard</a>
        <a href="/apex/RE_PropertyList">Properties</a>
        <a href="/apex/RE_LeadsList">Leads</a>
    </div>

    <div class="main-content">

        <h1>Welcome back, {!currentUserName}!</h1>

        <div class="summary-grid">
            <div class="summary-tile tile-blue">
                <h3>Total Properties</h3>
                <p>{!totalProperties}</p>
            </div>
            <div class="summary-tile tile-green">
                <h3>Portfolio Value</h3>
                <p>${!portfolioValue}</p>
            </div>
            <div class="summary-tile tile-orange">
                <h3>Active Leads</h3>
                <p>{!activeLeads}</p>
            </div>
            <div class="summary-tile tile-purple">
                <h3>Closed Deals</h3>
                <p>{!closedDeals}</p>
            </div>
        </div>

        <h2>Recent Properties</h2>
        <div class="card-section">
            <apex:repeat value="{!recentProperties}" var="prop">
                <div class="list-card">
                    <h4>{!prop.Name}</h4>
                    <p>Location: {!prop.City__c }</p>
                    <p>Value: ${!prop.Price__c}</p>
                </div>
            </apex:repeat>
        </div>

        <h2>Recent Leads</h2>
        <div class="card-section">
            <apex:repeat value="{!recentLeads}" var="ld">
                <div class="list-card">
                    <h4>{!ld.Name}</h4>
                    <p>Email: {!ld.Email}</p>
                    <span class="lead-status status-{!IF(ld.Status = 'Qualified', 'qualified', 'new')}">
                        {!ld.Status}
                    </span>
                </div>
            </apex:repeat>
        </div>

    </div>
    <div>
        <c:RE_Footer />
    </div>
</apex:page>