<apex:page controller="RE_LeadsListController" sidebar="false" showHeader="true">
    
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f9fafb;
            margin: 0;
            padding: 0;
            color: #374151;
        }
    
        h1, h2, h3 {
            color: #111827;
        }
    
        .dashboard-container {
            padding: 20px;
        }
    
        .summary-grid {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
    
        .summary-tile {
            flex: 1;
            padding: 20px;
            border-radius: 8px;
            color: #fff;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            font-size: 16px;
        }
    
        .tile-blue { background: #3b82f6; }
        .tile-green { background: #22c55e; }
        .tile-orange { background: #f97316; }
        .tile-purple { background: #a855f7; }
    
        .card-section {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
        }
    
        .list-card {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
            flex: 1 1 300px;
        }
    
        .sidebar {
            width: 220px;
            background: #1f2937;
            color: white;
            height: 100vh;
            padding: 20px;
            box-sizing: border-box;
            position: fixed;
            top: 0;
            left: 0;
        }
    
        .sidebar h3 {
            color: #fff;
            margin-bottom: 30px;
        }
    
        .sidebar a {
            display: block;
            color: white;
            padding: 12px 0;
            text-decoration: none;
            font-size: 14px;
        }
    
        .sidebar a:hover {
            background: #374151;
            border-radius: 4px;
            padding-left: 10px;
        }
    
        .main-content {
            margin-left: 220px;
            padding: 20px;
        }
    
        .lead-status {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 12px;
            color: white;
        }
    
        .status-qualified { background-color: #16a34a; }
        .status-new { background-color: #64748b; }
        .new-lead-form {
            background: #fff;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            max-width: 400px;
        }
    </style>


    <div class="sidebar">
        <h3>RealEstate CRM</h3>
        <a href="/apex/RE_Home">Dashboard</a>
        <a href="/apex/RE_PropertyList">Properties</a>
        <a href="/apex/RE_LeadsList">Leads</a>
    </div>

    <div class="main-content">

        <h1>Welcome back, {!currentUserName}!</h1>

        <apex:form>
            <div class="new-lead-form">
                <h2>Create New Lead</h2>
                <apex:pageBlock title="New Lead Details" mode="edit">
                    First Name : <apex:inputText value="{!newLead.FirstName}" label="First Name" /> <br/>
                    Last Name : <apex:inputText value="{!newLead.LastName}" label="Last Name" /> <br/>
                    Email : <apex:inputText value="{!newLead.Email}" label="Email" /> <br/>
                    Status : <apex:selectList value="{!newLead.Status}" size="1"> 
                        <apex:selectOptions value="{!leadStatusOptions}" />
                    </apex:selectList>
                    <br/><br/>
                    <apex:commandButton value="Save Lead" action="{!saveLead}" rerender="leadsList" />
                </apex:pageBlock>
            </div>
        </apex:form>

        <h2>Recent Leads</h2>
        <div class="card-section">
            <apex:repeat value="{!recentLeads}" var="ld">
                <div class="list-card">
                    <h4>{!ld.Name}</h4>
                    <p>Email: {!ld.Email}</p>
                    <span class="lead-status status-{!IF(ld.Status = 'Qualified', 'qualified', 'new')}">
                        {!ld.Status}
                    </span>
                </div>
            </apex:repeat>
        </div>
    </div>
</apex:page>